# GEMINI_API_KEY: Required for CivicLens AI server-side Gemini calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where CivicLens is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode to unlock Super Administrator privileges.
# If left unset, an authenticated user can complete the one-time first-run Admin Claim flow.
ADMIN_PASSCODE=""

# OPTIONAL SUPABASE / POSTGRESQL CONFIGURATION (for external production deployment)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
